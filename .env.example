# GitHub Personal Access Token — no scopes needed, only reads public data.
# Without it, GitHub API rate limit is 60 req/hour instead of 5000 req/hour.
GITHUB_TOKEN=

# Optional — enables the AI-generated comparison narrative on the compare page.
# Leave empty to disable; the rest of the app works fine without it.
ANTHROPIC_API_KEY=

# Optional — enables per-IP rate limiting on the AI narrative and the
# homepage "hot comparisons" leaderboard. Leave empty to disable both;
# they degrade gracefully (unlimited / no leaderboard) without these set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
